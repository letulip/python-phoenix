{
  "name": "python-phoenix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline PWA for rebuilding hands-on Python skills for live-coding interviews. Code runs in the browser on Pyodide; tests run on Node's built-in runner; the content gate runs on CPython.",
  "scripts": {
    "test": "node --test",
    "build:vendor": "esbuild tools/vendor-entry.js --bundle --minify --format=esm --target=safari15,chrome100,firefox100 --outfile=vendor/codemirror.js",
    "content": "python3 tools/build_content.py",
    "check": "sh tools/check.sh"
  },
  "devDependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2"
  }
}
